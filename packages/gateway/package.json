    "@dp/observability": "workspace:*",
    "@dp/prompts": "workspace:*",
    "@langchain/core": "catalog:",
    "@langchain/openai": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@dp/config": "workspace:*",
    "@types/node": "catalog:",
