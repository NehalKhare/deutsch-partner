      },
      "expect": { "estimatedLevel": "B1", "errors": [], "masterySignals": [{ "lemma": "weil", "direction": "up" }] }
    },
    {
      "id": "b1-register-slip",
      "note": "Switching to du with a stranger in a formal scene is a register_formality error, not a grammar one.",
      "input": {
        "learnerMessage": "Guten Tag, Herr Müller. Kannst du mir bitte helfen?",
        "precedingTurns": [{ "role": "assistant", "content": "Guten Tag, hier ist das Bürgeramt. Wie kann ich Ihnen helfen?" }]
      },
      "reference": {
        "estimatedLevel": "B1",
        "levelConfidence": 0.6,
        "vocabularyUsed": ["helfen"],
        "vocabularyWeaknesses": [],
        "grammarPatternsUsed": ["modal_verb_koennen"],
        "errors": [
          {
            "errorType": "register_formality",
            "excerpt": "Kannst du mir",
            "corrected": "Können Sie mir",
            "explanation": "Addressing an official you do not know calls for the formal \"Sie\", so the correct form is \"Können Sie mir bitte helfen?\"."
          }
        ],
        "skillEstimates": { "fluency": 0.7, "comprehension": 0.8, "accuracy": 0.7, "range": 0.6 },
        "masterySignals": [],
        "reviewCandidates": [],
        "recommendationSignals": ["formal_register"]
      },
      "expect": { "errors": [{ "errorType": "register_formality" }] }
    }
  ]
