{
  "name": "deutsch-partner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "turbo run test:db",
    "test:e2e": "turbo run test:e2e",
    "verify": "turbo run typecheck lint test build",
    "db:start": "pnpm --filter @dp/db db:start",
    "db:reset": "pnpm --filter @dp/db db:reset",
    "db:diff": "pnpm --filter @dp/db db:diff",
    "db:push": "pnpm --filter @dp/db db:push",
    "db:advisors": "pnpm --filter @dp/db db:advisors",
    "db:seed": "pnpm --filter @dp/learning seed",
    "curriculum:generate": "pnpm --filter @dp/learning generate:migrations",
    "ingest": "pnpm --filter @dp/worker ingest",
    "fx:refresh": "pnpm --filter @dp/worker fx:refresh",
    "product:implement": "pnpm --filter @dp/worker product:implement",
    "dummy:user": "pnpm --filter @dp/learner dummy:user",
    "scenarios:ingest": "uv run --project apps/learner/scripts/scenarios apps/learner/scripts/scenarios/ingest_scenarios.py",
    "scenarios:eval": "uv run --project apps/learner/scripts/scenarios --extra eval apps/learner/scripts/scenarios/eval_ragas.py",
    "scenarios:test": "uv run --project apps/learner/scripts/scenarios --extra dev -m pytest apps/learner/scripts/scenarios/tests",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "dev:learner": "turbo run dev --filter=@dp/learner",
    "dev:ops": "turbo run dev --filter=@dp/ops",
    "dev:worker": "turbo run dev --filter=@dp/worker"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.1",
    "turbo": "^2.5.0"
  },
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10.31"
  }
}
