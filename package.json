{
  "name": "german-partner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:push": "supabase db push",
    "db:advisors": "supabase db advisors",
    "test:db": "vitest run --project db",
    "test:unit": "vitest run --project unit",
    "curriculum:generate": "tsx scripts/generate-curriculum-migration.ts",
    "dummy:user": "tsx scripts/create-dummy-user.ts",
    "db:seed": "tsx scripts/apply-seeds.ts",
    "ingest": "tsx scripts/ingest.ts",
    "product:implement": "tsx scripts/product-implement.ts",
    "fx:refresh": "tsx scripts/refresh-fx.ts",
    "scenarios:ingest": "uv run --project scripts/scenarios scripts/scenarios/ingest_scenarios.py",
    "scenarios:eval": "uv run --project scripts/scenarios --extra eval scripts/scenarios/eval_ragas.py",
    "scenarios:test": "uv run --project scripts/scenarios --extra dev -m pytest scripts/scenarios/tests"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.12",
    "@langchain/langgraph-checkpoint": "^1.1.5",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.5.10",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "langchain": "^1.5.10",
    "langsmith": "^0.9.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-aria-components": "^1.20.0",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "@next/env": "^16.3.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
