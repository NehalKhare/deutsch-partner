# The queue worker's non-secret settings, matching deploy/cloudrun/worker.yaml.
NODE_ENV=production
# The overlay replaces this with SUPABASE_URL from site.env. The worker reads
# it at runtime; it has no browser bundle to bake it into.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.invalid
WORKER_QUEUES=jobs
WORKER_CONCURRENCY=4
WORKER_POLL_MS=2000
WORKER_LOCK_SECONDS=600
PORT=8080
# The image defaults to a 3 GiB heap, sized for the coder. This pod has 1 GiB,
# so a smaller ceiling makes Node collect garbage instead of being OOM-killed.
NODE_OPTIONS=--max-old-space-size=768
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=dp-worker
