# The learner app's non-secret settings. Secrets live in the learner-secrets
# Secret; see ../../overlays/gke/secrets/learner.env.example.
#
# Leave a model tier out to use the registry default. Naming a model here is
# an operations change, and the security tests keep it out of this file.
NODE_ENV=production
# The overlay replaces the host with the learner hostname from site.env.
APP_URL=https://learner.placeholder.invalid
# The public Supabase values, baked into the browser bundle at build time and
# also validated by the server at runtime. Both are public by design. The
# overlay replaces them with SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.invalid
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_placeholder
# Only a production deployment on its real domain should be indexed.
SEO_INDEXING=false
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=dp-learner
