# Your installation's settings. Copy to site.env (which git ignores) and fill
# in. Nothing here is secret. The GitHub workflow writes site.env itself from
# repository variables.

# The public hostname. It needs a DNS A record pointing at the static IP.
LEARNER_HOST=learner.example.com

# The name you gave the IP in `gcloud compute addresses create`.
STATIC_IP_NAME=dp-ip

# The images you pushed, including the tag.
# <region>-docker.pkg.dev/<project>/dp/dp-<app>:<tag>
LEARNER_IMAGE=europe-west1-docker.pkg.dev/my-project/dp/dp-learner:v1
WORKER_IMAGE=europe-west1-docker.pkg.dev/my-project/dp/dp-worker:v1

# Your Supabase project's public URL and publishable key: the same values
# baked into the web image. Both are public by design.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Only read when the coding worker is switched on. owner/repo.
GITHUB_REPOSITORY=your-github-user/your-repo
