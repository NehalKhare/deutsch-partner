# Secrets for the operator app. Copy to ops.env (which git ignores), fill in,
# and create the Secret with the command in deploy/k8s/README.md.
#
# There is no model key and no GitHub token here, on purpose: the operator
# app refuses to start if it is given one.

SUPABASE_SECRET_KEY=
# The same value in learner.env, ops.env and worker.env.
LOG_PSEUDONYM_SALT=
# Comma-separated Supabase user ids allowed to sign in. Empty means nobody.
OPERATOR_USER_IDS=
