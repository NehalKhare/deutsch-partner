# Secrets for the worker. Copy to worker.env (which git ignores), fill in, and
# create the Secret with the command in deploy/k8s/README.md.

SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=
# The same value in learner.env and worker.env.
LOG_PSEUDONYM_SALT=

# Optional. Required only if LANGSMITH_TRACING is turned on.
# LANGSMITH_API_KEY=
# Optional. The OTLP gateway credential, e.g. for Grafana Cloud.
# OTEL_EXPORTER_OTLP_HEADERS=
