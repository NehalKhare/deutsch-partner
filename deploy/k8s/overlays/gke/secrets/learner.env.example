# Secrets for the learner app. Copy to learner.env (which git ignores), fill
# in, and create the Secret with the command in deploy/k8s/README.md.
# Every name here is also in apps/learner/.env.example.

# Starts sb_secret_. Bypasses Row Level Security.
SUPABASE_SECRET_KEY=
OPENROUTER_API_KEY=
# The same value in learner.env and worker.env.
LOG_PSEUDONYM_SALT=

# Optional. Required only if LANGSMITH_TRACING is turned on.
# LANGSMITH_API_KEY=
# Optional. Only for a Trainer MCP server that wants a key.
# MCP_SERVER_API_KEY=
