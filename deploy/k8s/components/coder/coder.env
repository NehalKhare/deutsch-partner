# The coding worker's non-secret settings, matching
# deploy/cloudrun/worker-coder.yaml.
NODE_ENV=production
NEXT_PUBLIC_SUPABASE_URL=https://placeholder.invalid
# owner/repo. Replaced with GITHUB_REPOSITORY from site.env.
GITHUB_REPOSITORY=placeholder/placeholder
REPO_CHECKOUT_PATH=/workspace/repo
WORKER_QUEUES=coder
WORKER_CONCURRENCY=1
WORKER_POLL_MS=5000
WORKER_LOCK_SECONDS=2700
PORT=8080
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=dp-worker
