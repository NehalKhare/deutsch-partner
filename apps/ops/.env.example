# The operator app: product ops and the cost dashboard, on its own origin.
#
# Copy to .env.local for local development. Note what is absent: no model key
# and no repository token. This process reads the board and asks the worker;
# it never calls a model and never touches a checkout.

NODE_ENV=
APP_URL=
APP_NAME=

# The same project the learner app uses; operators are accounts in it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Must be the same value in every deployable, or ledger and audit pseudonyms
# stop joining.
LOG_PSEUDONYM_SALT=

# Comma-separated account ids allowed in. Unset means nobody.
OPERATOR_USER_IDS=

# The session cookie's name. Distinct from the learner app's so the two can
# share a host in development without overwriting each other.
OPS_COOKIE_NAME=dp-ops-auth
