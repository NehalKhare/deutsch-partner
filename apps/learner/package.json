  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "test:db": "vitest run --project db",
    "test:unit": "vitest run --project unit",
    "dummy:user": "tsx scripts/create-dummy-user.ts",
    "scenarios:ingest": "uv run --project scripts/scenarios scripts/scenarios/ingest_scenarios.py",
    "scenarios:eval": "uv run --project scripts/scenarios --extra eval scripts/scenarios/eval_ragas.py",
    "scenarios:test": "uv run --project scripts/scenarios --extra dev -m pytest scripts/scenarios/tests"
  },
