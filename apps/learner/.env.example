# Deutsch Partner — environment template.
# Copy to `.env.local` and fill in. Never commit real values.
# Validated by lib/env/schema.ts. Missing production secrets fail the build.

# --- Runtime -----------------------------------------------------------------
# development | test | production
NODE_ENV=
APP_URL=
APP_NAME=

# --- Search and answer engines ------------------------------------------------
# true | 1 | false | 0. Off unless stated, so a staging copy is never indexed:
# robots.txt disallows everything and every page carries noindex until this is
# true. Production sets it to true. See docs/seo-and-geo.md.
SEO_INDEXING=
# Site-ownership tokens from Google Search Console and Bing Webmaster Tools.
# Public by design (they are printed into the page head). Empty means no tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# --- Supabase ----------------------------------------------------------------
# Uses the current key format. The legacy JWT `anon` / `service_role` keys are
# retired at the end of 2026 and are rejected by lib/env/schema.ts.
#
# Public: inlined into the browser bundle. RLS-constrained. Starts sb_publishable_
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses Row Level Security. Starts sb_secret_
# Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- OpenRouter --------------------------------------------------------------
# Server-only. Gateway for everything the text product does: chat, completion
# and embeddings — including `pnpm ingest`, `pnpm scenarios:ingest` and
# retrieval at request time.
OPENROUTER_API_KEY=

# --- Model routing -----------------------------------------------------------
# Per-tier model ids. Leave empty to use the registry defaults in
# lib/ai/gateway/registry.ts. Application code names a tier and never a model,
# so swapping one here is an operations change, not a deployment.
# Format: vendor/model, exactly as OpenRouter states it. The stt and tts tiers
# name audio-capable chat models, which is how OpenRouter serves speech.
OPENROUTER_MODEL_REASONING=
OPENROUTER_MODEL_STRONG=
OPENROUTER_MODEL_MID=
OPENROUTER_MODEL_CHEAP=
OPENROUTER_MODEL_NANO=
# Served by OpenRouter like the chat tiers. Format: vendor/model.
EMBEDDING_MODEL=
# Not served by OpenRouter. These go direct to their own provider.
SPEECH_TO_TEXT_MODEL=
TEXT_TO_SPEECH_MODEL=

# --- Cost accounting ---------------------------------------------------------
# Server-only. Keys the pseudonymous learner id written to logs and to the usage
# ledger. Changing it makes past rows unjoinable to future ones, which is the
# intended behaviour when a deployment is reset, and a mistake otherwise.
LOG_PSEUDONYM_SALT=
# Euro per US dollar. Optional, and used only for calls made before the first
# `pnpm fx:refresh` lands a real snapshot — without it a cold database records
# those calls as unpriced rather than blocking them. The rate the ledger
# actually prices in comes from that job, which should run daily.
FX_EUR_PER_USD_BOOTSTRAP=

# --- LangSmith tracing -------------------------------------------------------
# true | 1 | false | 0. LANGSMITH_API_KEY is required when enabled.
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
# --- Trainer / MCP -------------------------------------------------------------
# A remote MCP server whose tools the Trainer's agent may use, over streamable
# HTTP. Leave empty and the Trainer runs on its local tools alone. DeepWiki is
# public and needs no key; a server that wants one gets MCP_SERVER_API_KEY as a
# bearer header. Note: the Trainer needs a tool-capable model on the strong
# tier — an OPENROUTER_MODEL_STRONG override without tool support breaks the
# Trainer, and a costly one is multiplied by its seven-step loop.
# Example: MCP_SERVER_URL=https://mcp.deepwiki.com/mcp
MCP_SERVER_URL=
MCP_SERVER_API_KEY=

# --- Payments (Stripe) ---------------------------------------------------------
# Server-only, and this app's alone: the operator app refuses both at boot and
# the worker is never given them. Leave both empty and payments are switched
# off — the pricing page still renders, nothing can be bought. Set one and the
# other is required. Use test-mode keys (sk_test_ / rk_test_) until the
# consumer-law pages are live; `pnpm --filter @dp/billing stripe:bootstrap`
# refuses a live key. There is no publishable key: hosted Checkout needs none.
# See .claude/docs/billing-and-plans-spec.md S12.
STRIPE_SECRET_KEY=
# The signing secret of the endpoint that posts to /api/billing/webhook.
# Starts whsec_. `stripe listen --forward-to localhost:3000/api/billing/webhook`
# prints one for local development.
STRIPE_WEBHOOK_SECRET=
# true | 1 | false | 0. Whether Checkout computes VAT with Stripe Tax. On only
# once the Stripe Tax registrations are in place. Not a secret.
STRIPE_AUTOMATIC_TAX=



# --- Development fixtures ----------------------------------------------------
# Read only by `pnpm dummy:user` and the fixture-login E2E spec, never by the
# application. The address must sit on a reserved domain such as example.com,
# so a fixture account can never mail a real person.
DEV_SEED_EMAIL=
# Leave empty and a fresh password is generated and printed on each run. Pin it
# here to keep the fixture sign-in stable across runs.
DEV_SEED_PASSWORD=
