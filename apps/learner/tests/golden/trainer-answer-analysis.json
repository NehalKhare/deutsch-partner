      "id": "v2-violation",
      "question": "Was machst du heute?",
      "answer": "Heute ich gehe ins Kino.",
      "gate": "analyze",
      "analysis": {
        "verdict": "partially_correct",
        "findings": [
          {
            "errorType": "word_order",
            "excerpt": "Heute ich gehe",
            "corrected": "Heute gehe ich",
            "note": "The verb stays in second position: when the sentence opens with Heute, the verb comes next."
          }
        ],
        "anglicisms": [],
        "vocabularyElevation": [],
        "register": { "verdict": "appropriate" }
      },
      "expected": { "verdict": "partially_correct", "errorTypes": ["word_order"], "register": "appropriate" }
