# The worker: the long-running process that drains the job queue.
#
# Copy to .env.local for local development. Every value is read once at boot
# and validated; production refuses to start without the required ones.

NODE_ENV=
APP_URL=
APP_NAME=

# The same project the apps use. The worker holds the secret key and nothing
# publishable: it serves no browser.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Every model call the worker makes: the product-ops agents, the embeddings.
OPENROUTER_API_KEY=
OPENROUTER_MODEL_REASONING=
OPENROUTER_MODEL_STRONG=
OPENROUTER_MODEL_MID=
OPENROUTER_MODEL_CHEAP=
OPENROUTER_MODEL_NANO=
EMBEDDING_MODEL=

# Must be the same value in every deployable, or ledger and audit pseudonyms
# stop joining.
LOG_PSEUDONYM_SALT=
FX_EUR_PER_USD_BOOTSTRAP=

LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=

# The coding worker only: a fine-grained token scoped to the one repository,
# and a checkout of it to plan against and cut worktrees from.
GITHUB_TOKEN=
GITHUB_REPOSITORY=
REPO_CHECKOUT_PATH=

# Which queues this process drains ("jobs", "coder", or both), how many jobs
# it runs at once, and whether it also enqueues the scheduled ones.
WORKER_QUEUES=jobs
WORKER_CONCURRENCY=2
WORKER_POLL_MS=2000
WORKER_LOCK_SECONDS=90
WORKER_SCHEDULER=true
PORT=8080
